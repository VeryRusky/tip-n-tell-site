# Copy this file to .env.development to run the site against the real backend:
#   cp .env.example .env.development
# (.env files are not committed. This one holds no secrets, only the API address.)
#
# VITE_API_URL: where the API lives. '/api' = the same website address; in development
# Vite forwards /api and /uploads to the backend on http://localhost:8000.
# Leave it unset (no .env.development file) to run on sample data, like the GitHub Pages demo.
VITE_API_URL=/api

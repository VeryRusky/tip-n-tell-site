# Copy this file to backend/.env and fill in the values. Never commit .env.
# Nothing here is a real secret: every value is blank or a placeholder.
# The comments say what happens when a value is left empty.

# development (your own computer) or production (the live host).
# Production is the SAFE default: anything other than "development" or "test" (capitals
# and spaces are ignored), including leaving it empty or typing "prod", counts as
# production and gets every production check. Keep "development" here for your computer.
NODE_ENV=development

# Port the API listens on. The frontend's dev server forwards /api here.
PORT=8000

# MongoDB connection string, e.g. from MongoDB Atlas:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database-name>
# Use a different database name on laptops (e.g. tipntell-dev) from the live site.
# Empty in development = a temporary in-memory database with sample data (lost on restart).
# Required in production.
MONGODB_URI=

# Signs the login cookie. At least 32 random characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Empty in development = a random one each start (you get signed out on restart).
# Required in production. The live host gets its OWN new secret, never one from a laptop.
SESSION_SECRET=

# The ONLY Google account that may sign in to the admin pages (her Gmail address).
# Changing it signs out every existing session at once.
ADMIN_EMAIL=

# OAuth client ID from Google Cloud Console (APIs & Services > Credentials).
# Looks like <numbers>-<letters>.apps.googleusercontent.com. Not a secret.
GOOGLE_CLIENT_ID=

# The site's own address(es), comma separated, exactly as the browser's address bar shows
# them: https://, no slash at the end. Admin changes are only accepted from these pages.
# Empty in development = http://localhost:5173,http://localhost:5180
# Required in production, e.g. https://<your-site-address>. On Render it may stay empty:
# the server then uses Render's own address (RENDER_EXTERNAL_URL, set by Render).
ALLOWED_ORIGINS=

# true shows a "Dev login" button that signs in without Google, for testing on your own
# computer only. The server REFUSES TO START if it is true and:
#   - NODE_ENV is anything but development/test, or
#   - MONGODB_URI is set (the dev login only works with the temporary database).
# Never set it on the live host. Leave empty to switch it off.
ALLOW_DEV_LOGIN=

# How many proxies sit in front of the server (the host's load balancers).
# Production: REQUIRED, a whole number of 1 or more, MEASURED on the host: Render's
# onrender.com address measured 3 (Nov 2026). Too low: visitors share rate-limit counters
# (or one visitor gets a new counter each time). Too high: a faked X-Forwarded-For header
# chooses the counter. Re-measure after adding her own domain or Cloudflare.
# How to measure: "Measuring TRUST_PROXY" in backend/README.md.
# "true" is never allowed (it lets anyone fake their IP). Leave empty on your own computer.
TRUST_PROXY=

# Booking details she notes on a slot (a customer's name, what they booked) are personal
# data. They are deleted from slots dated more than this many days ago, checked when the
# server starts and once a day. Whole number from 1 to 365. Empty = 30 (what the
# Policies page tells customers; change both together).
BOOKING_DETAILS_KEEP_DAYS=

# Where design photos are stored:
#   local      = files in backend/uploads/ (your computer)
#   cloudinary = Cloudinary (the live site: a free host wipes its own disk). Needs CLOUDINARY_URL.
# Production with "local" starts, but prints a warning.
STORAGE_DRIVER=local

# Only with STORAGE_DRIVER=cloudinary: the "API environment variable" from the Cloudinary
# dashboard, cloudinary://<api key>:<api secret>@<cloud name>. It is a SECRET: put it only
# in this .env (never committed) or in the host's dashboard.
CLOUDINARY_URL=

# true = this server also serves the built website (frontend/dist), like the live site does.
# Production always does. Use it to try the live set-up on your computer:
#   cd frontend && VITE_API_URL=/api pnpm build   (Git Bash: put MSYS_NO_PATHCONV=1 in front)
# then open http://localhost:8000 (and add it to ALLOWED_ORIGINS to make admin changes).
SERVE_FRONTEND=

# Where the built website is. Empty = frontend/dist (next to this backend folder).
FRONTEND_DIR=

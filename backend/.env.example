# Copy this file to backend/.env and fill in the values. Never commit .env.
# Every variable is optional on your own computer; the comments say what happens without it.

# development or production. On the live host set NODE_ENV=production.
NODE_ENV=development

# Port the API listens on. The frontend's dev server forwards /api here.
PORT=8000

# MongoDB connection string, e.g. from MongoDB Atlas:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tipntell
# Empty in development = a temporary in-memory database with sample data (lost on restart).
# Required in production.
MONGODB_URI=

# Signs the login cookie. At least 32 random characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Empty in development = a random one each start (you get signed out on restart).
# Required in production.
SESSION_SECRET=

# The ONLY Google account that may sign in to the admin pages (her Gmail address).
ADMIN_EMAIL=

# OAuth client ID from Google Cloud Console (APIs & Services > Credentials).
# Looks like 1234567890-abc123.apps.googleusercontent.com. Not a secret.
GOOGLE_CLIENT_ID=

# The site's own address(es), comma separated, with no slash at the end.
# Admin changes are only accepted from pages on these addresses.
# Empty in development = http://localhost:5173,http://localhost:5180
# On the live site, e.g. https://tipntell.example.com
ALLOWED_ORIGINS=

# true shows a "Dev login" button that signs in without Google, for testing on your
# own computer. The server refuses to start if this is true with NODE_ENV=production.
ALLOW_DEV_LOGIN=false

# How many proxies sit in front of the server (the host's load balancer). Usually 1 on
# Render or Railway, empty on your own computer. Needed for rate limits and secure cookies.
TRUST_PROXY=

# Where design photos are stored: local (backend/uploads/). A deploy will add cloudinary.
STORAGE_DRIVER=local
